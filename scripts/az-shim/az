#!/usr/bin/env python3
"""Test double for the Azure CLI.

Lets `terraform plan` run hermetically with ARM_USE_CLI=true and no Azure account:
the azurerm provider only *decodes* the token's claims locally and, for a plan that
creates resources (no data sources), never calls the Azure API. Never use for apply.
"""

import base64
import json
import sys
import time

TENANT = "00000000-0000-0000-0000-000000000000"
SUB = "00000000-0000-0000-0000-000000000000"


def b64(obj: dict[str, object]) -> str:
    raw = json.dumps(obj, separators=(",", ":")).encode()
    return base64.urlsafe_b64encode(raw).decode().rstrip("=")


def token() -> str:
    now = int(time.time())
    header = {"alg": "none", "typ": "JWT"}
    claims = {
        "aud": "https://management.azure.com/",
        "iss": f"https://sts.windows.net/{TENANT}/",
        "iat": now,
        "nbf": now,
        "exp": now + 3600,
        "appid": "00000000-0000-0000-0000-000000000000",
        "oid": "00000000-0000-0000-0000-000000000001",
        "sub": "00000000-0000-0000-0000-000000000001",
        "tid": TENANT,
        "ver": "1.0",
    }
    return f"{b64(header)}.{b64(claims)}.shim"


def main(argv: list[str]) -> int:
    cmd = " ".join(argv)
    if argv[:1] == ["version"]:
        print(json.dumps({"azure-cli": "2.64.0", "azure-cli-core": "2.64.0"}))
    elif argv[:2] == ["account", "show"]:
        print(
            json.dumps(
                {
                    "id": SUB,
                    "tenantId": TENANT,
                    "name": "az-shim",
                    "state": "Enabled",
                    "isDefault": True,
                    "environmentName": "AzureCloud",
                    "user": {"name": "az-shim@example.invalid", "type": "servicePrincipal"},
                }
            )
        )
    elif argv[:2] == ["account", "get-access-token"]:
        print(
            json.dumps(
                {
                    "accessToken": token(),
                    "tokenType": "Bearer",
                    "tenant": TENANT,
                    "subscription": SUB,
                    "expiresOn": time.strftime(
                        "%Y-%m-%d %H:%M:%S.000000", time.localtime(time.time() + 3600)
                    ),
                    "expires_on": int(time.time()) + 3600,
                }
            )
        )
    elif argv[:2] == ["account", "list"]:
        print(
            json.dumps(
                [
                    {
                        "id": SUB,
                        "tenantId": TENANT,
                        "name": "az-shim",
                        "state": "Enabled",
                        "isDefault": True,
                        "environmentName": "AzureCloud",
                    }
                ]
            )
        )
    else:
        sys.stderr.write(f"az-shim: unsupported command: {cmd}\n")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
